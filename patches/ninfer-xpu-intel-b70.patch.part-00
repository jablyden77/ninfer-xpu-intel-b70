diff --git a/CMakeLists.txt b/CMakeLists.txt
index 98ac0bbd..7ab7d5b6 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,5 +1,25 @@
 cmake_minimum_required(VERSION 3.28)
 
+set(NINFER_BACKEND "CUDA" CACHE STRING "NInfer backend: CUDA or XPU")
+set_property(CACHE NINFER_BACKEND PROPERTY STRINGS CUDA XPU)
+
+if(NINFER_BACKEND STREQUAL "XPU")
+  project(ninfer LANGUAGES C CXX)
+  set(CMAKE_CXX_STANDARD 20)
+  set(CMAKE_CXX_STANDARD_REQUIRED ON)
+  set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
+  if(NOT CMAKE_CXX_COMPILER_ID MATCHES "IntelLLVM")
+    message(FATAL_ERROR "XPU backend requires Intel oneAPI icpx; got ${CMAKE_CXX_COMPILER_ID}")
+  endif()
+  add_subdirectory(src/xpu)
+  return()
+endif()
+
+if(NOT NINFER_BACKEND STREQUAL "CUDA")
+  message(FATAL_ERROR "Unsupported NINFER_BACKEND='${NINFER_BACKEND}'")
+endif()
+
+
 # The current implementation is compiled only for sm_120a. Set and validate the
 # architecture before CUDA compiler detection so CMake never injects a generic
 # host-toolchain default or accepts an unsupported target.
